server {
    listen 127.0.0.1:{{ stack.web.nginx_port }} default_server;
    server_name _;
    client_max_body_size 5m;
    access_log /var/log/nginx/otus-access.log;
    error_log /var/log/nginx/otus-error.log;
    location /static/ { alias {{ stack.paths.shared }}/static/; }
    location /media/ { alias {{ stack.paths.shared }}/media/; }
    location / { proxy_pass http://127.0.0.1:{{ stack.portal.upstream_port }}; proxy_set_header Host $host; }
}
