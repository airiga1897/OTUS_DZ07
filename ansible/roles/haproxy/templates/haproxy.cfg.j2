global
    log /dev/log local0
    user haproxy
    group haproxy
    daemon
defaults
    log global
    option httplog
    mode http
    timeout connect 3s
    timeout client 60s
    timeout server 60s
frontend site
    bind 0.0.0.0:{{ stack.web.haproxy_port }}
    default_backend nginx
backend nginx
    option httpchk
    http-check send meth GET uri /health/ready ver HTTP/1.1 hdr Host localhost
    http-check expect status 200
    server app 127.0.0.1:{{ stack.web.nginx_port }} check
