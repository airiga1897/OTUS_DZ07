{
  "provider": "selectel",
  "terraform_directory": "terraform-selectel",
  "required_capabilities": ["network_isolation", "hard_anti_affinity", "placement_hints"],
  "api": {"timeout_seconds": 15, "read_attempts": 3, "retry_delay_seconds": 2},
  "audit": {
    "read_workers": 3,
    "service_exclusions": {"volumev3": ["ru-4", "ru-5"]}
  }
}
