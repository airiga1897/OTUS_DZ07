# Non-secret run settings. Credentials are entered through scripts/env.ps1.
REQUIRE_DISTINCT_HOSTS=true
SELECTEL_PREFERRED_POOLS=ru-2,ru-9,ru-3
SELECTEL_EXCLUDED_POOLS=ru-7,ru-4,ru-5,ru-6,kz-1,ke-1,gis-1,gis-2,uz-1,uz-2
SELECTEL_EXCLUDED_SEGMENTS=ru-1b
SELECTEL_DISK_TYPE_PATTERNS=universal.*,basicssd.*
SELECTEL_FLAVOR_NAME_PATTERNS=SL1.{vcpus}-{ram_mb},SL2.{vcpus}-{ram_mb}-AMD
APP_VCPUS=4
APP_RAM_MB=8192
ES_VCPUS=2
ES_RAM_MB=8192
BOOT_DISK_GB=20
